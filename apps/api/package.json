{
  "name": "@hedged/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:db": "tsx --env-file=../../.env --test src/store/store-contract.test.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@fastify/cors": "^11.0.0",
    "@hedged/arc": "workspace:*",
    "@hedged/shared": "workspace:*",
    "@hedged/solana": "workspace:*",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.119.0",
    "bn.js": "^5.2.5",
    "fastify": "^5.12.8",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
