# Copy to .env (never commit .env). Devnet ONLY. All tokens are valueless test tokens.
# Server-only values must NEVER be exposed via NEXT_PUBLIC_*.

# --- Solana (Devnet) ---
SOLANA_CLUSTER=devnet
# Public Devnet fallback; prefer your QuickNode endpoint below.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Commitment required before the backend processes a deposit
SOLANA_FINALITY=finalized

# --- QuickNode (server-only; endpoint URLs embed an API key) ---
QUICKNODE_RPC_URL=
QUICKNODE_WSS_URL=
# Optional: QuickNode Streams webhook/destination
QUICKNODE_STREAMS_SECURITY_TOKEN=

# --- Anchor program / mock mint ---
# Fixed by programs/escrow (declare_id!); currently E6tFGqHoSUpQmL3U5u8TmYHDJnjdHm8yKk4KifJUt4zr
ANCHOR_PROGRAM_ID=
# Mock USD stablecoin (6 decimals) created by Dev 2 on Devnet. NOT real USDC.
MOCK_USDC_MINT=
MOCK_USDC_DECIMALS=6

# --- Escrow ops scripts (Dev 2; programs/escrow/docs/DEVNET.md) ---
# Read from the process environment (load with `set -a; source .env; set +a`). Paths point OUTSIDE the
# repo; never commit keys. Scripts refuse mainnet and any non-Devnet RPC unless ALLOW_NON_DEVNET=1.
# Customer-recovery timeout in seconds (1..2592000): after deposited_at + this, a customer may cancel a
# still-Deposited purchase. Devnet default 600 (10 minutes). Applies to promos created afterwards.
CANCEL_TIMEOUT_SECS=600
# Fee payer AND mint authority for pnpm escrow:mint
PAYER_KEYPAIR_PATH=
# Deployer = program upgrade authority = Config.admin (pnpm escrow:init-config / escrow:check --online)
ADMIN_KEYPAIR_PATH=
DEPLOYER_KEYPAIR_PATH=
# Stable address for the mock mint (created if absent, mode 0600). Default ~/.config/hedged/mock-usd-mint.json
MOCK_MINT_KEYPAIR_PATH=
# Comma list of "pubkey" or "pubkey:wholeTokens" to top up with mock USD; default target per wallet
MINT_RECIPIENTS=
MINT_TOPUP_TOKENS=1000
# Set to 1 ONLY to run the scripts against a local validator
ALLOW_NON_DEVNET=

# --- Authorized relayer (server-only) ---
# Path to a relayer keypair JSON outside the repo, e.g. ~/.config/solana/relayer.json. Never commit.
RELAYER_KEYPAIR_PATH=
# Public key only (safe to share); must match Config.relayer on-chain (set by initialize_config /
# set_relayer; there is no Promo.relayer). Keep it separate from the deployer/admin key.
RELAYER_PUBLIC_KEY=

# --- Gemini Predictions (READ-ONLY; backend-only) ---
# Verified 2026-11-16: events, settlement and order books are public and need NO credentials.
# Leave the key/secret empty; the read-only client never sends them.
GEMINI_API_BASE_URL=https://api.gemini.com
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Hard guard: the API refuses to start unless this is "true".
GEMINI_READ_ONLY=true
# Quotes older than this are rejected by the hedge simulator.
HEDGE_MAX_QUOTE_AGE_MS=15000
# Modeled Gemini trading fee in bps of premium (0 = fees not modeled).
HEDGE_FEE_BPS=0

# --- Backend workers (apps/api) ---
# none = API only. fake = IN-MEMORY fake chain (not Solana). real = Dev 3's Devnet gateway, built from
# the SOLANA_* / QUICKNODE_* / RELAYER_* variables above (needs RELAYER_KEYPAIR_PATH = Config.relayer).
# With real + QUICKNODE_STREAMS_SECURITY_TOKEN set, QuickNode Streams posts to /webhooks/quicknode.
SOLANA_GATEWAY=none
# How often to check for official Gemini outcomes (5-minute windows settle ~5 s after they end).
RESOLVE_POLL_MS=5000
# Reconciliation sweep interval (also runs once at boot).
RECONCILE_MS=60000
# Exposure desk (simulated netting across shops; apps/api/src/desk): order lot size in contracts and
# rebalance interval. Runs with the workers.
DESK_LOT_CONTRACTS=10
DESK_REBALANCE_MS=15000

# --- Supabase (server-only) ---
# URL: https://<project-ref>.supabase.co. Key: the SECRET key (sb_secret_..., formerly
# "service_role"), never the publishable/anon key. Server-only; never NEXT_PUBLIC_*.
# Unset = the API runs on an in-memory store that is lost on restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend server ---
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# --- Web (browser-visible; contains NO secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Use the public Devnet URL or a domain-restricted endpoint; keys here ship to browsers.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_ANCHOR_PROGRAM_ID=
NEXT_PUBLIC_MOCK_USDC_MINT=

# --- Solana infrastructure (Dev 3, packages/solana; server-only) ---
# Event feed for the gateway subscriptions: websocket (logsSubscribe + RPC sweep) or streams
# (QuickNode Streams webhook is the primary feed; a slow RPC sweep fills gaps).
SOLANA_EVENT_SOURCE=websocket
# Gap-filler sweep interval (ms; default 5000 websocket / 30000 streams) and privileged-call budget (ms).
SOLANA_SWEEP_MS=
SOLANA_TX_TIMEOUT_MS=90000
# QuickNode account API key: only for `pnpm --filter @hedged/solana streams:create`.
QUICKNODE_API_KEY=
# Public URL QuickNode posts to (e.g. an ngrok URL ending in /webhooks/quicknode).
STREAMS_WEBHOOK_URL=
# Port of the standalone receiver (`pnpm --filter @hedged/solana streams:webhook`).
STREAMS_WEBHOOK_PORT=4100

# --- Arc (branch `arc`; packages/arc/README.md). Server-only unless NEXT_PUBLIC_. ---
# SOLANA_GATEWAY=arc switches apps/api to the Arc escrow.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WSS_URL=
ARC_ESCROW_ADDRESS=
NEXT_PUBLIC_ARC_ESCROW_ADDRESS=
# Key files OUTSIDE the repo (scripts/keygen.ts writes ~/.config/arc/<name>.json). Never commit.
ARC_RELAYER_KEY_PATH=
ARC_DEPLOYER_KEY_PATH=
ARC_FINALITY=finalized
# poll | websocket | streams
ARC_EVENT_SOURCE=poll

# --- Circle email-login wallets (apps/api; docs/email-wallets.md) ---
# Server-only testnet key (TEST_API_KEY:...), Restricted: Wallets + Faucet API. Never NEXT_PUBLIC_.
CIRCLE_API_KEY=
# App ID (not secret): Circle console > Wallets > User Controlled > Configurator.
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=
# EOA (default) or SCA. Arc gas is USDC either way.
CIRCLE_ACCOUNT_TYPE=EOA
# First approval allows up to this much USDC (6-decimal base units), so later purchases are one tap.
CHECKOUT_ALLOWANCE_CAP=100000000
