{
  "name": "hedged-refund-promotions",
  "private": true,
  "version": "0.0.0",
  "description": "Simulation-first Solana hackathon MVP: on-chain conditional refunds + simulated prediction-market hedging (Devnet only).",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @hedged/web dev",
    "dev:api": "pnpm --filter @hedged/api dev",
    "dev:sample": "node scripts/sample-api.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "anchor:build": "anchor build",
    "escrow:mint": "ts-node -P programs/escrow/scripts/tsconfig.json programs/escrow/scripts/create-mock-mint.ts",
    "escrow:init-config": "ts-node -P programs/escrow/scripts/tsconfig.json programs/escrow/scripts/init-config.ts",
    "escrow:check": "ts-node -P programs/escrow/scripts/tsconfig.json programs/escrow/scripts/check-readiness.ts",
    "escrow:verify-docs": "ts-node -P programs/escrow/scripts/tsconfig.json programs/escrow/scripts/verify-docs.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@eslint/js": "^9.39.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.5.0",
    "eslint": "^9.39.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
